        "enable": true,
        "hide": true,
        "iconColor": "rgba(0,211,255,1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "EventFlow CQRS Platform \u2014 ingestion service, query service, Kafka consumer, JVM, and HTTP metrics",
